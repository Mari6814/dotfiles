#!/bin/bash

# # dotfiles
# This is the functions script used by `install` and `remove`
#
# ## Installation
# Install all packages:
#
# ```bash
# ./install
# ```
#
# Only *some* packages:
#
# ```bash
# ./install git tmux
# ```
#
# ## Uninstall
# To remove all packages:
#
# ```bash
# ./remove
# ```
#
# To remove some packages:
#
# ```bash
# ./remove git tmux
# ```
#
# ## Git update
# Before you `git pull` to get the changes, make sure you have *removed* all packages once first,
# to make sure we don't leave any symlinks behind:
#
# ```bash
# ./remove
# git pull
# ```
#
# ## Inventory
# This script creates symlinks from its current directory architecture,
# which means if the architecture changes *before you manage to cleanup the current one*
# then symlinks might be left behind. Override by setting `DOTFILES_INVENTORY`.
#
# By default we store the inventory in
#   `$XDG_STATE_HOME/dotfiles/inventory`
# which is `$HOME/.local/state/dotfiles/inventory` unless `XDG_STATE_HOME` is set.
#
# It is just a list of all symlinks ever created.
# Automatically cleaned up with every `ENABLE_PACKAGES` enabled execution.
#
# ## Package paths
# Within a package, `dot-` is replaced with `.` (for example `dot-bashrc` becomes `.bashrc`).
#
# A path component wrapped in braces references an environment variable, resolved when the
# package is linked:
#
#   `packages/bash/{XDG_DATA_HOME}/bash-completion/completions/foo.bash`
#
# `XDG_CONFIG_HOME`, `XDG_DATA_HOME`, `XDG_STATE_HOME`, and `XDG_CACHE_HOME` default to their
# standard locations when unset or empty. Any other empty variable causes that file to be
# skipped with a warning.
#
# Paths that resolve to an absolute location are linked there directly; relative paths are
# linked under `$TARGET_DIR`.

PACKAGE_ICON="📦"
FILE_ICON="📄"
DIRECTORY_ICON="📁"
SUCCESS_ICON="✅"
FAILURE_ICON="❌"
WARNING_ICON="⚠️"
LINK_ICON="🔗"
VERBOSE_ENABLED=$(echo "$@" | grep -q -- "-v" && echo "true" || echo "false")
ENABLE_PACKAGES=$(echo "$@" | grep -q -- "--enable" && echo "true" || echo "false")
DISABLE_PACKAGES=$(echo "$@" | grep -q -- "--disable" && echo "true" || echo "false")
PACKAGE_SEARCH=$(echo "$@" | sed 's/-v//g' | sed 's/--enable//g' | sed 's/--disable//g' | xargs)
SCRIPT_DIR="$(dirname "$0")"
PACKAGES_DIR="$(realpath "$SCRIPT_DIR/packages")"
PACKAGES_LIST=$(cd "$PACKAGES_DIR" && echo *)
TARGET_DIR="${TARGET_DIR:-$HOME}"
# XDG base directories default to the locations defined by the XDG Base Directory Specification.
: "${XDG_CONFIG_HOME:=$HOME/.config}"
: "${XDG_DATA_HOME:=$HOME/.local/share}"
: "${XDG_STATE_HOME:=$HOME/.local/state}"
: "${XDG_CACHE_HOME:=$HOME/.cache}"
RED="$(tput setaf 1)"
GREEN="$(tput setaf 2)"
YELLOW="$(tput setaf 3)"
BLUE="$(tput setaf 4)"
DIM="$(tput setaf dim)"
RESET="$(tput sgr0)"

INVENTORY="${DOTFILES_INVENTORY:-$XDG_STATE_HOME/dotfiles/inventory}"

# Exit if enable & disable are both enabled
if [ "$ENABLE_PACKAGES" = "true" ] && [ "$DISABLE_PACKAGES" = "true" ]; then
    echo "$RED$FAILURE_ICON Cannot enable and disable packages at the same time$RESET" >&2
    exit 1
fi

if [ "$VERBOSE_ENABLED" = "true" ] && [ ! -z "$PACKAGE_SEARCH" ]; then
    if [ "$ENABLE_PACKAGES" = "true" ]; then
        echo "Enabling $PACKAGE_SEARCH packages"
    fi
    if [ "$DISABLE_PACKAGES" = "true" ]; then
        echo "Disabling $PACKAGE_SEARCH packages"
    fi
fi
if [ "$VERBOSE_ENABLED" = "true" ]; then
    echo "Running script from"
    echo "$DIRECTORY_ICON $SCRIPT_DIR"
fi
if [ "$VERBOSE_ENABLED" = "true" ]; then
    echo "Looking for packages in"
    echo "$DIRECTORY_ICON $PACKAGES_DIR"
fi
if [ "$VERBOSE_ENABLED" = "true" ]; then
    echo "Packages available:"
    for package in $PACKAGES_LIST; do
        echo "$PACKAGE_ICON $package"
    done
fi
if [ "$VERBOSE_ENABLED" = "true" ]; then
    echo "Installing packages in"
    echo "$DIRECTORY_ICON $TARGET_DIR"
fi

cleanup_stale_symlink_inventory() {
    local cleaned_up=false
    local path
    local tmp_inventory

    [[ -r "$INVENTORY" ]] || {
        echo "Inventory not readable: $INVENTORY" >&2
        return 1
    }

    tmp_inventory=$(mktemp) || {
        echo "Failed to create temporary inventory." >&2
        return 1
    }

    while IFS= read -r path; do
        path="${path%$'\r'}"
        [[ -z "$path" || "$path" == \#* ]] && {
            printf '%s\n' "$path" >> "$tmp_inventory"
            continue
        }

        [[ "$VERBOSE_ENABLED" = "true" ]] && echo "Reading: $path"

        if [[ ! -L "$path" ]]; then
            [[ "$VERBOSE_ENABLED" = "true" ]] && echo "Discarded: not a symlink"
        elif [[ ! -e "$path" ]]; then
            if rm -- "$path"; then
                echo "Cleaned up stale symlink: $path"
                prune_empty_parents "$(dirname -- "$path")"
                cleaned_up=true
            else
                echo "Failed to remove: $path" >&2
                printf '%s\n' "$path" >> "$tmp_inventory"
            fi
        else
            printf '%s\n' "$path" >> "$tmp_inventory"
            [[ "$VERBOSE_ENABLED" = "true" ]] && echo "Kept: $path"
        fi
    done < "$INVENTORY"

    if ! cat "$tmp_inventory" > "$INVENTORY"; then
        echo "Failed to update inventory: $INVENTORY" >&2
        rm -f -- "$tmp_inventory"
        return 1
    fi

    rm -f -- "$tmp_inventory"

    [[ "$cleaned_up" = false ]] &&
        echo "No stale symlinks found in $INVENTORY."
}

# Resolve dot- placeholders and {VARIABLE} placeholders in a package-relative path.
resolve_link_path() {
    local path=$1
    local original=$1
    local placeholder
    local variable

    # dot- is the legacy placeholder for a leading dot.
    path=${path//dot-/.}

    while [[ $path =~ \{([A-Za-z_][A-Za-z0-9_]*)\} ]]; do
        placeholder=${BASH_REMATCH[0]}
        variable=${BASH_REMATCH[1]}

        if [[ -z "${!variable-}" ]]; then
            echo "$WARNING_ICON ${YELLOW}Skipping $original: \$$variable is not set or empty$RESET" >&2
            return 1
        fi

        path=${path//"$placeholder"/"${!variable}"}
    done

    printf '%s' "$path"
}

# After unlinking a symlink, remove its parent directory and keep walking up
# while the directories are empty. Stops at the first rmdir failure (non-empty
# directory, or a parent that is itself a symlink) and never touches "/".
prune_empty_parents() {
    local dir=$1
    while [[ "$dir" != "/" && "$dir" != "." ]]; do
        rmdir -- "$dir" 2>/dev/null || break
        [[ "$VERBOSE_ENABLED" = "true" ]] && echo "$PACKAGE_ICON $dir removed"
        dir=$(dirname -- "$dir")
    done
    return 0
}

function package_show_files() {
    # Operate on each package provided
    PACKAGE_NAMES="${@:-$PACKAGES_LIST}"
    for PACKAGE_NAME in $PACKAGE_NAMES; do
        echo
        # Check that the package is available in the packages directory
        PACKAGE_DIR="$PACKAGES_DIR/$PACKAGE_NAME"
        if [ ! -d "$PACKAGE_DIR" ]; then
            echo "$RED$FAILURE_ICON Package $PACKAGE_NAME not found$RESET" >&2
            return 1
        fi

	echo "$PACKAGE_ICON $PACKAGE_NAME:"
        # List of all available files in that package
        AVAILABLE_FILES=$(find "$PACKAGE_DIR" -type f)
        if [ "$VERBOSE_ENABLED" = "true" ]; then
            for FILE in $AVAILABLE_FILES; do
                echo "$FILE_ICON $FILE"
            done
        fi

        # Operate on each file in the package
        for FILE in $AVAILABLE_FILES; do 
            # Generate the link name, relative to the package directory
            LINK="${FILE#"$PACKAGE_DIR/"}"
            # Resolve dot- and {VARIABLE} placeholders
            if ! LINK=$(resolve_link_path "$LINK"); then
                continue
            fi

            # Absolute resolved paths are used as-is, relative paths live under TARGET_DIR
            if [[ "$LINK" == /* ]]; then
                DEST="$LINK"
            else
                DEST="$TARGET_DIR/$LINK"
            fi

            # Disable installed files from the package
            if [ "$DISABLE_PACKAGES" = "true" ]; then
                if [ -L "$DEST" ]; then
                    if [ "$VERBOSE_ENABLED" = "true" ]; then
                        rm -v "$DEST" \
                            && echo "$LINK_ICON$BLUE $DEST$RESET" \
                            && prune_empty_parents "$(dirname -- "$DEST")" \
                            || echo "${RED}Failed to unlink $DEST$LINK_ICON$RESET" >&2
                    else
                        rm "$DEST" \
                            && echo "$LINK_ICON$BLUE $DEST$RESET" \
                            && prune_empty_parents "$(dirname -- "$DEST")" \
                            || echo "${RED}Failed to unlink $DEST$LINK_ICON$RESET" >&2
                    fi
                else
                    echo "$FAILURE_ICON $RED$DEST$LINK_ICON cannot be removed or is not a link$RESET" >&2
                fi
                continue
            fi

            # Enable available files from the package
            if [ "$ENABLE_PACKAGES" = "true" ]; then
                # Skip if something already exists at the target location
                if [ -e "$DEST" ] || [ -L "$DEST" ]; then
                    echo "$DEST$LINK_ICON... ${BLUE}SKIPPING$RESET" >&2
                    continue
                fi

                # Generate the directory path for the link
                DIR=$(dirname "$DEST")
                if [ ! -d "$DIR" ]; then
                    if [ "$VERBOSE_ENABLED" = "true" ]; then
                        mkdir -pv "$DIR" \
                            && echo "$PACKAGE_ICON $DIR created" \
                            || echo "${RED}Failed to create directory $DIR$RESET" >&2
                    else
                        mkdir -p "$DIR" \
                            || echo "${RED}Failed to create directory $DIR$RESET" >&2
                    fi
                fi

                # Link the file to that location
                if [ "$VERBOSE_ENABLED" = "true" ]; then
                    ln -sv "$FILE" "$DEST"
                else
                    ln -s "$FILE" "$DEST"
                fi

                if [ $? -eq 0 ]; then
                    echo "$LINK_ICON ${GREEN}$DEST$RESET"
                    mkdir -p "$(dirname "$INVENTORY")"

                    if [ ! -f "$INVENTORY" ]; then
                        cat > "$INVENTORY" <<'EOF'
# Dotfiles symlink inventory
#
# Contains all symlinks ever created by my dotfiles/install script.
# You can iterate this list, check for broken symlinks that still
# exist, and clean them up.
#
EOF
                    fi

                    if ! grep -Fxq "$DEST" "$INVENTORY"; then
                        printf '%s\n' "$DEST" >> "$INVENTORY"
                    fi
                else
                    echo "${RED}Failed to link $DEST$RESET"
                fi
            fi
        done
    done

    if [ "$ENABLE_PACKAGES" = "true" ]; then
        cleanup_stale_symlink_inventory
    fi
}

package_show_files "$PACKAGE_SEARCH"
