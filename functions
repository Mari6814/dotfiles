#!/bin/bash

# # dotfiles
# This is the functions script used by `install` and `remove`
#
# ## Installation
# Install all packages:
#
# ```bash
# ./install
# ```
#
# Only *some* packages:
#
# ```bash
# ./install git tmux
# ```
#
# ## Uninstall
# To remove all packages:
#
# ```bash
# ./remove
# ```
#
# To remove some packages:
#
# ```bash
# ./remove git tmux
# ```
#
# ## Git update
# Before you `git pull` to get the changes, make sure you have *removed* all packages once first,
# to make sure we don't leave any symlinks behind:
#
# ```bash
# ./remove
# git pull
# ```
#
# ## Inventory
# This script creates symlinks from its current directory architecture,
# which means if the architecture changes *before you manage to cleanup the current one*
# then symlinks might be left behind. Override by setting `DOTFILES_INVENTORY`.
#
# By default we store the inventory in
#   `$HOME/.local/state/dotfiles/inventory`
#
# It is just a list of all symlinks ever created.
# Automatically cleaned up with every `ENABLE_PACKAGES` enabled execution.

PACKAGE_ICON="📦"
FILE_ICON="📄"
DIRECTORY_ICON="📁"
SUCCESS_ICON="✅"
FAILURE_ICON="❌"
LINK_ICON="🔗"
VERBOSE_ENABLED=$(echo "$@" | grep -q -- "-v" && echo "true" || echo "false")
ENABLE_PACKAGES=$(echo "$@" | grep -q -- "--enable" && echo "true" || echo "false")
DISABLE_PACKAGES=$(echo "$@" | grep -q -- "--disable" && echo "true" || echo "false")
PACKAGE_SEARCH=$(echo "$@" | sed 's/-v//g' | sed 's/--enable//g' | sed 's/--disable//g' | xargs)
SCRIPT_DIR="$(dirname "$0")"
PACKAGES_DIR="$(realpath "$SCRIPT_DIR/packages")"
PACKAGES_LIST=$(cd "$PACKAGES_DIR" && echo *)
TARGET_DIR="${TARGET_DIR:-$HOME}"
RED="$(tput setaf 1)"
GREEN="$(tput setaf 2)"
BLUE="$(tput setaf 4)"
DIM="$(tput setaf dim)"
RESET="$(tput sgr0)"

INVENTORY="${DOTFILES_INVENTORY:-${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/inventory}"

# Exit if enable & disable are both enabled
if [ "$ENABLE_PACKAGES" = "true" ] && [ "$DISABLE_PACKAGES" = "true" ]; then
    echo "$RED$FAILURE_ICON Cannot enable and disable packages at the same time$RESET" >&2
    exit 1
fi

if [ "$VERBOSE_ENABLED" = "true" ] && [ ! -z "$PACKAGE_SEARCH" ]; then
    if [ "$ENABLE_PACKAGES" = "true" ]; then
        echo "Enabling $PACKAGE_SEARCH packages"
    fi
    if [ "$DISABLE_PACKAGES" = "true" ]; then
        echo "Disabling $PACKAGE_SEARCH packages"
    fi
fi
if [ "$VERBOSE_ENABLED" = "true" ]; then
    echo "Running script from"
    echo "$DIRECTORY_ICON $SCRIPT_DIR"
fi
if [ "$VERBOSE_ENABLED" = "true" ]; then
    echo "Looking for packages in"
    echo "$DIRECTORY_ICON $PACKAGES_DIR"
fi
if [ "$VERBOSE_ENABLED" = "true" ]; then
    echo "Packages available:"
    for package in $PACKAGES_LIST; do
        echo "$PACKAGE_ICON $package"
    done
fi
if [ "$VERBOSE_ENABLED" = "true" ]; then
    echo "Installing packages in"
    echo "$DIRECTORY_ICON $TARGET_DIR"
fi

cleanup_stale_symlink_inventory() {
    local cleaned_up=false

    [[ -r "$INVENTORY" ]] || { echo "Inventory not readable: $INVENTORY" >&2; return 1; }

    while IFS= read -r path; do
        path="${path%$'\r'}"
        [[ -z "$path" || "$path" == \#* ]] && continue

        [[ "$VERBOSE_ENABLED" = "true" ]] && echo "Reading: $path"

        if [[ ! -L "$path" ]]; then
            [[ "$VERBOSE_ENABLED" = "true" ]] && echo "Discarded: not a symlink"
        elif [[ ! -e "$path" ]]; then
            if rm ${VERBOSE_ENABLED:+ -v} -- "$path"; then
                echo "Cleaned up stale symlink: $path"
                cleaned_up=true
            else
                echo "Failed to remove: $path" >&2
            fi
        else
            [[ "$VERBOSE_ENABLED" = "true" ]] && echo "Discarded: not broken"
        fi
    done < "$INVENTORY"

    [[ "$cleaned_up" = false ]] && echo "No stale symlinks found."
}

function package_show_files() {
    # Operate on each package provided
    PACKAGE_NAMES="${@:-$PACKAGES_LIST}"
    for PACKAGE_NAME in $PACKAGE_NAMES; do
        echo
        # Check that the package is available in the packages directory
        PACKAGE_DIR="$PACKAGES_DIR/$PACKAGE_NAME"
        if [ ! -d "$PACKAGE_DIR" ]; then
            echo "$RED$FAILURE_ICON Package $PACKAGE_NAME not found$RESET" >&2
            return 1
        fi

	echo "$PACKAGE_ICON $PACKAGE_NAME:"
        # List of all available files in that package
        AVAILABLE_FILES=$(find "$PACKAGE_DIR" -type f)
        if [ "$VERBOSE_ENABLED" = "true" ]; then
            for FILE in $AVAILABLE_FILES; do
                echo "$FILE_ICON $FILE"
            done
        fi

        # Operate on each file in the package
        for FILE in $AVAILABLE_FILES; do 
            # Resolve the link name by replacing dot- placeholders with actual dots
            LINK=$(echo "$FILE" | sed 's/dot-/./g')
            # Generate the link name, relative to the package directory
            LINK="${LINK#$PACKAGE_DIR/}"

            # Disable installed files from the package
            if [ "$DISABLE_PACKAGES" = "true" ]; then
                if [ -L "$TARGET_DIR/$LINK" ]; then
                    if [ "$VERBOSE_ENABLED" = "true" ]; then
                        rm -v "$TARGET_DIR/$LINK" \
                            && echo "$LINK_ICON$BLUE $TARGET_DIR/$LINK$RESET" \
                            || echo "${RED}Failed to unlink $TARGET_DIR/$LINK$LINK_ICON$RESET" >&2
                    else
                        rm "$TARGET_DIR/$LINK" \
                            && echo "$LINK_ICON$BLUE $TARGET_DIR/$LINK$RESET" \
                            || echo "${RED}Failed to unlink $TARGET_DIR/$LINK$LINK_ICON$RESET" >&2
                    fi
                else
                    echo "$FAILURE_ICON $RED$LINK$LINK_ICON cannot be removed or is not a link$RESET" >&2
                fi
                continue
            fi

            # Enable available files from the package
            if [ "$ENABLE_PACKAGES" = "true" ]; then
                # Skip if something already exists at the target location
                if [ -e "$TARGET_DIR/$LINK" ] || [ -L "$TARGET_DIR/$LINK" ]; then
                    echo "$LINK$LINK_ICON... ${BLUE}SKIPPING$RESET" >&2
                    continue
                fi

                # Generate the directory path for the link
                DIR=$(dirname "$TARGET_DIR/$LINK")
                if [ ! -d "$DIR" ]; then
                    if [ "$VERBOSE_ENABLED" = "true" ]; then
                        mkdir -pv "$DIR" \
                            && echo "$PACKAGE_ICON $DIR created" \
                            || echo "${RED}Failed to create directory $DIR$RESET" >&2
                    else
                        mkdir -p "$DIR" \
                            || echo "${RED}Failed to create directory $DIR$RESET" >&2
                    fi
                fi

                # Link the file to that location
                if [ "$VERBOSE_ENABLED" = "true" ]; then
                    ln -sv "$FILE" "$TARGET_DIR/$LINK"
                else
                    ln -s "$FILE" "$TARGET_DIR/$LINK"
                fi

                if [ $? -eq 0 ]; then
                    echo "$LINK_ICON ${GREEN}$TARGET_DIR/$LINK$RESET"
                    mkdir -p "$(dirname "$INVENTORY")"

                    if [ ! -f "$INVENTORY" ]; then
                        cat > "$INVENTORY" <<'EOF'
# Dotfiles symlink inventory
#
# Contains all symlinks ever created by my dotfiles/install script.
# You can iterate this list, check for broken symlinks that still
# exist, and clean them up.
#
EOF
                    fi

                    if ! grep -Fxq "$TARGET_DIR/$LINK" "$INVENTORY"; then
                        printf '%s\n' "$TARGET_DIR/$LINK" >> "$INVENTORY"
                    fi
                else
                    echo "${RED}Failed to link $TARGET_DIR/$LINK$RESET"
                fi
            fi
        done
    done

    if [ "$ENABLE_PACKAGES" = "true" ]; then
        cleanup_stale_symlink_inventory
    fi
}

package_show_files "$PACKAGE_SEARCH"
