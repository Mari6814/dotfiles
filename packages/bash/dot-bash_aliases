#!/bin/bash
export SOURCED=".bash_aliases@`date +%H%m%S`:$SOURCED"

aalias() {
    if [[ $1 != *=* ]]; then
        echo "Usage: aalias name=command" >&2
        return 2
    fi

    local name=${1%%=*}
    local target=${1#*=}
    local cmd=${target%%[[:space:]]*}
    local spec quoted_name

    # Define the alias.
    alias "$name=$target" || return

    # Find the target command's completion specification.
    spec=$(complete -p "$cmd" 2>/dev/null) || return 0

    # Register the same completion for the alias.
    spec=${spec% "$cmd"}
    printf -v quoted_name '%q' "$name"
    eval "$spec $quoted_name"
}


aalias clipboard="xclip -sel clip"

aalias e="$EDITOR"

# Shortcuts to edit specific files
alias evim="e ~/.vimrc"
alias envim="e ~/.config/nvim/init.lua"
alias erc="e ~/.bashrc && source ~/.bashrc"
alias ealias="e ~/.bash_aliases && source ~/.bash_aliases"
alias etmux="e ~/.tmux.conf"

aalias g="git"
alias gs="git status"

alias tree="tree -C -I '.git|node_modules|.venv|__pycache__|.cache|.mypy_cache|.pytest_cache|.ipynb_checkpoints'"

alias wiki="nvim -c VimwikiIndex"
alias diary="nvim -c VimwikiMakeDiaryNote"

alias zz="cd -"

aalias mkdir="mkdir -pv"
aalias rmdir="rmdir -pv"

alias aptuu="sudo apt -y update && sudo apt -y upgrade"

alias s="screen"
alias sl="s -ls"
alias ss="s -S"
alias sr="s -r"

aalias py="python3"
alias m="py -m"
alias jn="jupyter notebook"
alias va="source .venv/bin/activate"

# enable color support of ls and also add handy aliases
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'

    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

# Modify the default values for builtins
aalias ls="ls --color=auto --group-directories-first -CFh"
aalias ll='ls -al' # List all files *with details*, including dotfiles
aalias la='ls -A' # List all file *names* except . and .., including dotfiles
aalias l='ls -CF' # shorthand for ls

md() {
    # Create a directory and move into it
    mkdir -p "$@" && cd "$@";
}

should_print_help() {
    # Returns 0 in case that --help|-h was detected in arguments
    # Usage: `if should_print_help "$@"; then echo ...; return; fi`
    local arg
    for arg in "$@"; do
    [[ "$arg" == "-h" || "$arg" == "--help" ]] && return 0
    done
    return 1
}

etmp() {
    # Open a temporary file in the default editor
    if should_print_help "$@"; then
        echo "Usage: etmp [SUFFIX]";
        return 0
    fi
    local file="$(mktemp)$1";
    "${EDITOR:-vim}" "$file";
    echo "$file";
}

mkcmd() {
    # Open a new file in EDITOR, prefilled with bash shebang & executable flag set
    local name="${1:?Usage: cmd <PATH>}"

    if ! (set -o noclobber; printf '#!/usr/bin/env bash\n\n' > "$name"); then
        printf 'Error: cannot create or write "%s"\n' "$name" >&2
        return 1
    fi

    chmod +x -- "$name" || return 1
    "${EDITOR:-vim}" "$name"
}

taildate() {
    # Print the date and time of the last line of a file
    tail -f "$1" | xargs -IL date +"%Y-%m-%d %H:%M:%S L"
}

watch-files() {
    # Exits if the watched files are touched
    watch -gt "ls -lR --full-time $@ | md5sum"
}

# Load machine-local aliases that are not commited into git
[ -s "$HOME/.bash_aliases.local" ] && \. "$HOME/.bash_aliases.local"
[ -s "$LOCAL/bash_aliases" ] && \. "$LOCAL/bash_aliases"
