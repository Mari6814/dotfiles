# ~/.bashrc: executed by bash(1) for non-login shells.
export SOURCED="$BASH_SOURCE@`date +%H%m%S`:$SOURCED"

# Default to `vim`, but if nvim is installed, it will later override this with `nvim`
export EDITOR=vim

# append to the history file, don't overwrite it
shopt -s histappend

# for setting history length see HISTSIZE and HISTFILESIZE in bash(1)
HISTSIZE=10000
HISTFILESIZE=20000

# check the window size after each command and, if necessary,
# update the values of LINES and COLUMNS.
shopt -s checkwinsize

# If set, the pattern "**" used in a pathname expansion context will
# match all files and zero or more directories and subdirectories.
shopt -s globstar

# CD by directly typing in the path to a directory
shopt -s autocd

# Expands symbolic representations of paths
shopt -s direxpand

shrink_path() {
  # Transforms the current PWD from '~/projects/repo/src' to '~/p/r/src' and '/etc/nginx/conf' to '/e/n/conf'.
  # 1. Take PWD and replace the Home path with ~
  # 2. Use sed to find every character followed by more characters and a slash,
  #    then replace it with just that first character and the slash.
  echo "${PWD/#$HOME/\~}" | sed -E 's|([^/])[^/]+(/)|\1\2|g'
}

# Adds the current git branch at the end of the prompt
[ -f "/etc/bash_completion.d/git-prompt" ] && source /etc/bash_completion.d/git-prompt && export PS1='\[\033[01;34m\]$(shrink_path)\[\033[00m\]$(__git_ps1 " %s")\$ '
[ -f "/usr/share/bash-completion/completions/git" ] && source /usr/share/bash-completion/completions/git

# enable programmable completion features (you don't need to enable
# this, if it's already enabled in /etc/bash.bashrc and /etc/profile
# sources /etc/bash.bashrc).
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

# Set up the user's "local" directory
export LOCAL="$HOME/.local"

# Put custom isolated scripts here
[ -d "$LOCAL/bin" ] && export PATH="$PATH:$LOCAL/bin"

# Machine local & untracked, version of bashrc
[ -s "$HOME/.bashrc.local" ] && \. "$HOME/.bashrc.local"
[ -s "$LOCAL/bashrc" ] && \. "$LOCAL/bashrc"

# Dynamically load bashrc modules. Used when other packages want to dynamically extend bashrc without modifying bashrc.
[ -d "$LOCAL/bashrc.d" ] && for f in "$LOCAL/bashrc.d/"*.{bash,sh}; do
    [ -s "$f" ] && \. "$f"
done

command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init bash --cmd z)"

export FZF_CTRL_R_OPTS="--height=7 --reverse --inline-info"
[ -f ~/.fzf.bash ] && source ~/.fzf.bash

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# Load aliases as a separate module
[ -s "$HOME/.bash_aliases" ] && \. "$HOME/.bash_aliases"
