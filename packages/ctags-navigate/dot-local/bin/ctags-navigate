#!/usr/bin/env bash
# ctags-navigate - pick a symbol from the current project and open or print
# its location.
#
# Builds an ad-hoc ctags index for the current Git root (or the current
# directory outside Git) in /tmp, lets fzf pick a symbol, and opens it in
# $EDITOR or prints its location. Nothing is written into the project.
#
# The ctags-navigate package binds C-x C-t in Bash. The tmux fragment sends
# that key to the current pane.
#
# The index is cached under /tmp/ctags-navigate/<cache-key>.tags.
# Rebuild it with --rebuild.

set -euo pipefail

PROG=${0##*/}
STATE_DIR=/tmp/ctags-navigate
CACHE_VERSION=2
MAX_DEPTH=5
# Unit separator: fzf's and read's default tab handling would collapse empty
# fields (scope is often empty), shifting the following columns.
FIELD_SEP=$'\x1f'

# Directory names that are never useful for symbol navigation. Git's ignore
# rules are applied separately via `git ls-files`. `vendor` is handled
# separately: only Composer-generated vendor directories are skipped.
DEFAULT_EXCLUDES=(
    .git .hg .svn
    node_modules
    build dist target
    .venv venv
    __pycache__ .mypy_cache .pytest_cache .ruff_cache .tox
    .next .nuxt .svelte-kit coverage
    .idea .vscode
    .gradle
    Pods DerivedData
    .terraform
)

usage() {
    cat <<EOF
Usage: $PROG [OPTIONS] [QUERY...]

Pick a symbol from the current project and open it in \$EDITOR, or print its
location.

The tags index is built once per project root and cached in
/tmp/ctags-navigate. Inside a Git repository it contains tracked and untracked
(non-ignored) files. Outside Git the current directory is used as the root and
traversal stops after $MAX_DEPTH directory levels. Nested Git repositories
are never crawled: their symbols belong to their own index. Generated
directories such as node_modules, .venv, and Composer vendor directories are
skipped.

By default, pressing Enter in the picker opens the selection in \$EDITOR.
Passing --format makes Enter print it instead. --non-interactive skips the
picker and prints every matching location.

Inside fzf (available keys depend on the command being completed):
  Enter            Open the selection in \$EDITOR, or print it with --format
  Alt-p            Path only
  Alt-f            Filename only
  Alt-d            Directory only
  Alt-s            Symbol only
  Alt-o            Open in \$EDITOR

Options:
  -h, --help       Show this help message and exit.
  -r, --rebuild    Rebuild the cached index before searching.
      --format FMT Output format: full (FILE:LINE), path, filename, dirname,
                   or symbol. With the picker, prints the selection instead
                   of opening it.
  -a, --absolute   Print absolute paths.
  -o, --open       Open the selected symbol in \$EDITOR at its line.
      --non-interactive
                   Skip the picker and print every matching location.
      --actions SPEC
                   Internal: comma-separated KEY=ACTION list for fzf.
      --raw        Print ACTION<US>PATH<US>LINE<US>SYMBOL<US>ROOT for shell integrations.
      --root       Print the resolved root and index path, then exit.
      --preview FILE LINE
                   Internal: render the fzf preview for FILE at LINE.

Positional arguments are joined into the fzf query, or used to filter matches
with --non-interactive.
EOF
}

die() {
    printf '%s: %s\n' "$PROG" "$*" >&2
    exit 1
}

# Absolute Git root, or the physical current directory when not in Git.
resolve_root() {
    local root
    if root=$(git rev-parse --show-toplevel 2>/dev/null) && [[ -n $root ]]; then
        printf '%s\n' "$root"
    else
        pwd -P
    fi
}

sha256_hex() {
    local hash
    if command -v sha256sum >/dev/null 2>&1; then
        hash=$(printf '%s' "$1" | sha256sum)
    elif command -v shasum >/dev/null 2>&1; then
        hash=$(printf '%s' "$1" | shasum -a 256)
    else
        die "sha256sum or shasum is required"
    fi
    printf '%s\n' "${hash%% *}"
}

index_path() {
    printf '%s/%s.tags\n' "$STATE_DIR" "$(sha256_hex "$CACHE_VERSION:$1")"
}

# Print NUL-separated paths relative to the root.
list_files() {
    local root=$1
    local ex
    local -a prune=()

    if git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        git -C "$root" ls-files -z --cached --others --exclude-standard
        return
    fi

    for ex in "${DEFAULT_EXCLUDES[@]}"; do
        (( ${#prune[@]} )) && prune+=(-o)
        prune+=(-name "$ex")
    done

    # Do not descend into nested repositories: their symbols belong to their
    # own index, not to the directory that happens to contain them. A vendor
    # directory is only generated when Composer left autoload.php in it.
    find "$root" -mindepth 1 -maxdepth "$MAX_DEPTH" \
        \( "${prune[@]}" \) -prune -o \
        -type d -name vendor -exec test -e '{}/autoload.php' \; -prune -o \
        -type d -exec test -e '{}/.git' \; -prune -o \
        -type f -print0
}

# Drop excluded and generated directories from a NUL-separated path list.
filter_files() {
    local root=$1
    local file rel ex skip part prefix
    local -a parts
    local -A generated_vendor=()

    while IFS= read -r -d '' file; do
        if [[ $root == / ]]; then
            rel=${file#/}
        elif [[ $file == "$root"/* ]]; then
            rel=${file#"$root"/}
        else
            rel=${file#./}
        fi

        skip=0
        for ex in "${DEFAULT_EXCLUDES[@]}"; do
            if [[ "/$rel/" == *"/$ex/"* ]]; then
                skip=1
                break
            fi
        done
        (( skip )) && continue

        # A vendor directory is only generated when Composer left
        # autoload.php in it. Cache the decision per vendor directory.
        if [[ $rel == vendor/* || $rel == */vendor/* ]]; then
            prefix=
            IFS=/ read -r -a parts <<<"$rel"
            for part in "${parts[@]}"; do
                prefix+=${prefix:+/}$part
                [[ $part == vendor ]] || continue

                if [[ -z ${generated_vendor[$prefix]+x} ]]; then
                    if [[ -e $root/$prefix/autoload.php ]]; then
                        generated_vendor[$prefix]=1
                    else
                        generated_vendor[$prefix]=0
                    fi
                fi

                if (( generated_vendor[$prefix] )); then
                    skip=1
                    break
                fi
            done
        fi
        (( skip )) && continue

        printf '%s\0' "$rel"
    done
}

build_tags() {
    local root=$1 languages lang
    local -a kind_args=()

    # Heredocs are parser artifacts, not navigable symbols, so disable that
    # kind per shell language. Only pass the flag for languages this ctags
    # build actually knows about; otherwise ctags warns and skips the index.
    languages=$(ctags --list-languages 2>/dev/null) || languages=
    languages=${languages//$'\n'/ }
    for lang in Sh Zsh; do
        if [[ " $languages " == *" $lang "* ]]; then
            kind_args+=("--kinds-$lang=-h")
        fi
    done

    (
        cd "$root" || return 1
        list_files "$root" |
            filter_files "$root" |
            tr '\0' '\n' |
            ctags --quiet=yes --sort=yes --excmd=number --fields=+KSnzZ \
                ${kind_args[@]+"${kind_args[@]}"} \
                -f - -L -
    )
}

build_index() {
    local root=$1 index=$2
    local tmp

    if [[ -e $STATE_DIR && ! -d $STATE_DIR ]]; then
        die "$STATE_DIR exists but is not a directory"
    fi
    [[ -d $STATE_DIR ]] || mkdir -p -m 700 -- "$STATE_DIR" || die "cannot create $STATE_DIR"

    tmp=$(mktemp "$STATE_DIR/.tags.XXXXXX") || die "cannot create a temporary tags file"
    if ! build_tags "$root" >"$tmp"; then
        rm -f -- "$tmp"
        die "ctags failed for $root"
    fi
    mv -f -- "$tmp" "$index" || {
        rm -f -- "$tmp"
        die "cannot write $index"
    }
}

# name<US>kind<US>scope<US>file<US>line
emit_records() {
    local index=$1

    awk -F '\t' -v sep="$FIELD_SEP" '
        /^!/ { next }
        NF < 4 { next }
        {
            line = $3
            sub(/;"$/, "", line)
            if (line !~ /^[0-9]+$/) next

            kind = "symbol"
            scope = ""
            for (i = 4; i <= NF; i++) {
                if ($i ~ /^kind:/) {
                    kind = $i
                    sub(/^kind:/, "", kind)
                } else if ($i ~ /^scope:/) {
                    scope = $i
                    sub(/^scope:/, "", scope)
                }
            }

            # Here-document labels (usually "EOF") are parser artifacts, not
            # navigable symbols. Filter them from cached indexes as well as
            # disabling the kind when building a fresh index.
            if (kind == "heredoc") next

            file = $2
            sub(/^\.\//, "", file)

            printf "%s%s%s%s%s%s%s%s%s\n", \
                   $1, sep, kind, sep, scope, sep, file, sep, line
        }
    ' "$index"
}

# Internal fzf preview. Called as: ctags-navigate --preview FILE LINE
preview_file() {
    local rel=$1 line=$2 root file start end shown
    root=$(resolve_root)
    file="$root/$rel"

    [[ $line =~ ^[0-9]+$ ]] || line=1
    start=$(( line > 2 ? line - 2 : 1 ))
    end=$(( line + 2 ))

    shown=$(relative_path "$root" "$rel")
    printf '%s:%s\n\n' "$shown" "$line"

    if command -v batcat >/dev/null 2>&1; then
        batcat --color=always --style=numbers \
            --highlight-line "$line" --line-range "$start:$end" -- "$file"
    elif command -v bat >/dev/null 2>&1; then
        bat --color=always --style=numbers \
            --highlight-line "$line" --line-range "$start:$end" -- "$file"
    else
        awk -v start="$start" -v end="$end" -v line="$line" '
            NR >= start && NR <= end {
                printf "%s%6d  %s\n", (NR == line ? ">" : " "), NR, $0
            }
        ' "$file"
    fi
}

relative_path() {
    local root=$1 rel=$2
    local target="$root/$rel" pwd_phys path

    pwd_phys=$(pwd -P)
    if [[ $target == "$pwd_phys"/* ]]; then
        printf '%s\n' "${target#"$pwd_phys"/}"
        return
    fi
    if command -v realpath >/dev/null 2>&1; then
        path=$(realpath -m -s --relative-to="$pwd_phys" -- "$target")
    else
        path=$target
    fi
    printf '%s\n' "$path"
}

# Action name used when printing a location in a given --format.
format_action() {
    case $1 in
        full) printf '%s' location-generic ;;
        path) printf '%s' path ;;
        filename) printf '%s' filename ;;
        dirname) printf '%s' dirname ;;
        symbol) printf '%s' symbol ;;
        *) return 1 ;;
    esac
}

resolve_path() {
    local root=$1 file=$2
    if (( print_absolute )); then
        printf '%s/%s\n' "$root" "$file"
    else
        relative_path "$root" "$file"
    fi
}

print_raw_record() {
    local action=$1 path=$2 line=$3 name=$4 root=$5
    printf '%s%s%s%s%s%s%s%s%s\n' \
        "$action" "$FIELD_SEP" "$path" "$FIELD_SEP" "$line" "$FIELD_SEP" \
        "$name" "$FIELD_SEP" "$root"
}

print_formatted_record() {
    local action=$1 path=$2 line=$3 name=$4 dir
    case $action in
        location-vim) printf '+%s %q\n' "$line" "$path" ;;
        location-code) printf -- '-g %q:%s\n' "$path" "$line" ;;
        location-generic) printf '%s:%s\n' "$path" "$line" ;;
        path) printf '%s\n' "$path" ;;
        filename) printf '%s\n' "${path##*/}" ;;
        dirname)
            dir=${path%/*}
            [[ $dir == "$path" ]] && dir=.
            printf '%s\n' "$dir"
            ;;
        symbol) printf '%s\n' "$name" ;;
        *) return 1 ;;
    esac
}

print_record() {
    local action=$1 root=$2 name=$3 file=$4 line=$5
    local path
    path=$(resolve_path "$root" "$file") || return
    if (( raw_output )); then
        print_raw_record "$action" "$path" "$line" "$name" "$root"
    else
        print_formatted_record "$action" "$path" "$line" "$name"
    fi
}

# Non-interactive mode: filter the index with fzf's own matcher, then print
# every match. --nth=1 limits matching to the symbol name, just like the
# picker. --tiebreak=index prefers the tags file's sorted order on ties.
print_matches() {
    local index=$1 query=$2 action=$3 root=$4
    local name kind scope file line status=0

    emit_records "$index" |
        fzf --filter="$query" --delimiter="$FIELD_SEP" --nth=1 \
            --tiebreak=index |
        while IFS=$FIELD_SEP read -r name kind scope file line; do
            print_record "$action" "$root" "$name" "$file" "$line" || exit 1
        done || status=$?

    return "$status"
}

self_path() {
    local self=${BASH_SOURCE[0]}
    if command -v readlink >/dev/null 2>&1; then
        self=$(readlink -f -- "$self" 2>/dev/null || printf '%s' "$self")
    fi
    printf '%s\n' "$self"
}

force_rebuild=0
format=full
format_set=0
print_absolute=0
open_editor=0
non_interactive=0
raw_output=0
actions_spec=""
query=""

while (( $# > 0 )); do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -r|--rebuild)
            force_rebuild=1
            shift
            ;;
        --format)
            (( $# >= 2 )) || die "--format requires an argument"
            format=$2
            format_set=1
            shift 2
            ;;
        --format=*)
            format=${1#*=}
            format_set=1
            shift
            ;;
        -a|--absolute)
            print_absolute=1
            shift
            ;;
        --actions)
            (( $# >= 2 )) || die "--actions requires an argument"
            actions_spec=$2
            shift 2
            ;;
        --actions=*)
            actions_spec=${1#*=}
            shift
            ;;
        -o|--open)
            open_editor=1
            shift
            ;;
        --non-interactive)
            non_interactive=1
            shift
            ;;
        --raw)
            raw_output=1
            shift
            ;;
        --root)
            root=$(resolve_root)
            printf 'root: %s\nindex: %s\n' "$root" "$(index_path "$root")"
            exit 0
            ;;
        --preview)
            (( $# >= 3 )) || die "--preview requires FILE and LINE"
            preview_file "$2" "$3"
            exit 0
            ;;
        --)
            shift
            while (( $# > 0 )); do
                query+="${query:+ }$1"
                shift
            done
            ;;
        -?*)
            printf '%s: unknown option: %s\n' "$PROG" "$1" >&2
            usage >&2
            exit 2
            ;;
        *)
            query+="${query:+ }$1"
            shift
            ;;
    esac
done

case "$format" in
    full|path|filename|dirname|symbol) ;;
    *) die "invalid format: $format (expected full, path, filename, dirname, or symbol)" ;;
esac

if (( non_interactive )); then
    (( open_editor )) && die "--open cannot be used with --non-interactive"
    [[ -z $actions_spec ]] || die "--actions cannot be used with --non-interactive"
fi

command -v ctags >/dev/null 2>&1 || die "ctags is required"
command -v fzf >/dev/null 2>&1 || die "fzf is required"

root=$(resolve_root)
index=$(index_path "$root")

if (( force_rebuild )) || [[ ! -f $index ]]; then
    printf '%s: building symbol index for %s\n' "$PROG" "$root" >&2
    build_index "$root" "$index"
fi

if (( non_interactive )); then
    action=$(format_action "$format") || die "invalid format: $format"
    print_matches "$index" "$query" "$action" "$root" || exit $?
    exit 0
fi

# Actions are KEY=ACTION pairs. The shell passes a context-specific list so
# the fzf modal only offers shortcuts that make sense for the command line.
if [[ -z $actions_spec ]]; then
    if (( ! format_set || open_editor )); then
        enter_action=open-editor
    else
        enter_action=$(format_action "$format") || die "invalid format: $format"
    fi
    actions_spec="enter=$enter_action,alt-o=open-editor,alt-p=path,alt-f=filename,alt-d=dirname,alt-s=symbol"
fi

declare -A action_for=()
declare -A action_label=(
    [location-vim]='+LINE FILE'
    [location-code]='-g FILE:LINE'
    [location-generic]='FILE:LINE'
    [path]='path'
    [filename]='filename'
    [dirname]='directory'
    [symbol]='symbol'
    [open-editor]="open in ${EDITOR:-vi}"
)
action_keys=()
IFS=',' read -r -a action_entries <<<"$actions_spec"
for entry in "${action_entries[@]}"; do
    [[ -n $entry ]] || continue
    key=${entry%%=*}
    action=${entry#*=}
    if [[ $key == "$entry" || -z $action ]]; then
        die "invalid action: $entry"
    fi
    if [[ -z ${action_label[$action]+x} ]]; then
        die "invalid action: $action"
    fi
    action_for[$key]=$action
    action_keys+=("$key")
done
[[ -n ${action_for[enter]+x} ]] || die "actions must define enter"

expect_keys=()
for key in "${action_keys[@]}"; do
    [[ $key == enter ]] && continue
    expect_keys+=("$key")
done
expect_list=
if (( ${#expect_keys[@]} )); then
    expect_list=$(IFS=,; printf '%s' "${expect_keys[*]}")
fi

header=
for key in "${action_keys[@]}"; do
    action=${action_for[$key]}
    header+="${header:+   }$key: ${action_label[$action]}"
done

self=$(self_path)
self_q=$(printf '%q' "$self")

fzf_args=(
    --delimiter="$FIELD_SEP"
    --with-nth=1
    --nth=1
    --query="$query"
    --prompt='symbol> '
    --reverse
)
if [[ -n $expect_list ]]; then
    fzf_args+=(--expect="$expect_list")
fi
fzf_args+=(
    --header="$header"
    --height='30%'
    --preview-window='right,60%,wrap'
    --preview="$self_q --preview {4} {5}"
)

selected=$(
    emit_records "$index" |
        fzf "${fzf_args[@]}"
) || {
    status=$?
    # 1: no match, 130: cancelled.
    (( status == 1 || status == 130 )) && exit 0
    exit "$status"
}

[[ -n $selected ]] || exit 0

key=enter
record=$selected
if [[ $selected == *$'\n'* ]]; then
    first=${selected%%$'\n'*}
    rest=${selected#*$'\n'}
    record=${rest%%$'\n'*}
    [[ -n $first ]] && key=$first
fi

[[ -n $record ]] || exit 0

action=${action_for[$key]-}
[[ -n $action ]] || die "unexpected fzf key: $key"

IFS=$FIELD_SEP read -r name kind scope file line <<<"$record"
target="$root/$file"

# --raw is used by shell integrations inside command substitutions. It must
# always return the record and never launch an editor.
if (( raw_output )); then
    print_record "$action" "$root" "$name" "$file" "$line"
    exit 0
fi

if (( open_editor )) || [[ $action == open-editor ]]; then
    read -r -a editor <<<"${EDITOR:-vi}"
    exec "${editor[@]}" "+$line" "$target"
fi

print_record "$action" "$root" "$name" "$file" "$line" ||
    die "cannot print action: $action"
