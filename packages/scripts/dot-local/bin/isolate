#!/bin/bash
# TODOS: No temp dir if dirs are passed. remove temp home dir?
set -euo pipefail

usage() {
  cat <<EOF
Usage: $(basename "$0") [OPTIONS] [DIRECTORY ...]

Run OpenCode in a rootless Podman container.

Arguments:
  DIRECTORY       Existing directories to mount under /app/<basename>.
                  If omitted, a temporary directory is mounted at /app.

Options:
  -h, --help      Show this help message and exit.

Examples:
  $(basename "$0")
  $(basename "$0") ~/projects/myapp
  $(basename "$0") testtest/ myapp/
EOF
}

for arg in "$@"; do
  case "$arg" in
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      echo "Error: unknown option: $arg" >&2
      usage >&2
      exit 1
      ;;
  esac
done

VOLUMES=()
CONTAINER_DIR="/app"

if [[ $# -eq 0 ]]; then
  APP_DIR="$(mktemp -d /tmp/opencode-app-XXXXXX)"
  chmod 755 "$APP_DIR"
  echo "Temporary project directory: $APP_DIR"
  VOLUMES+=(--volume "${APP_DIR}:/app")
else
  declare -A SEEN_DIRS=()

  for dir in "$@"; do
    if [[ ! -d "$dir" ]]; then
      echo "Error: directory does not exist: $dir" >&2
      exit 1
    fi

    APP_DIR="$(realpath "$dir")"
    DIR_NAME="$(basename "$APP_DIR")"

    if [[ "$DIR_NAME" == "/" || "$DIR_NAME" == "." ]]; then
      echo "Error: cannot mount filesystem root as a named directory: $dir" >&2
      exit 1
    fi

    if [[ -n "${SEEN_DIRS[$DIR_NAME]:-}" ]]; then
      echo "Error: duplicate directory name: $DIR_NAME" >&2
      exit 1
    fi

    SEEN_DIRS["$DIR_NAME"]=1
    VOLUMES+=(--volume "${APP_DIR}:/app/${DIR_NAME}")
  done
fi

# Writable temporary home for OpenCode
HOME_DIR="$(mktemp -d /tmp/opencode-home-XXXXXX)"
chmod 755 "$HOME_DIR"
VOLUMES+=(--volume "${HOME_DIR}:/home/opencode")

echo "Temporary OpenCode home: $HOME_DIR"

exec podman run -it \
  --userns=keep-id \
  "${VOLUMES[@]}" \
  --env HOME=/home/opencode \
  --env XDG_CONFIG_HOME=/home/opencode/.config \
  --env XDG_DATA_HOME=/home/opencode/.local/share \
  --env XDG_STATE_HOME=/home/opencode/.local/state \
  --workdir "$CONTAINER_DIR" \
  ghcr.io/anomalyco/opencode
