#!/usr/bin/env bash
# # SSH Sessionizer
# A bash script that uses FZF to quickly connect, sessionize and create a connection
# history for my past ssh connections.
#
# ## Installation
# Add this to your `~/.tmux.conf` to open ssh-sessionizer in a popup:
#
# ```sh
# bind C-s display-popup -E "ssh-sessionizer"
# ```
#
# ## History
# The history is created at `~/.local/state/ssh-sessionizer/history` by default.
# Customize it by setting `SSH_SESSIONIZER_HISTFILE`.

set -euo pipefail

HISTFILE="${SSH_SESSIONIZER_HISTFILE:-${XDG_STATE_HOME:-$HOME/.local/state}/ssh-sessionizer/history}"

if [[ $# -eq 1 ]]; then
    selection="$1"
else
    mkdir -p "$(dirname "$HISTFILE")"
    touch "$HISTFILE"
    selection="$(fzf --tac --prompt='user@host: ' --print-query < "$HISTFILE" | tail -n1 || true)"
fi

if [ -z "$selection" ]; then
    exit 0
fi

# Prepare a tmpfile because filtering requires one...
TMP_HISTFILE="$(mktemp "/tmp/$(basename "$HISTFILE").XXXXXX")"
cleanup() {
    [[ -f "$TMP_HISTFILE" ]] && rm -f "$TMP_HISTFILE"
}
trap cleanup EXIT

# Append selection to history file, removing duplicates
grep -Fxv -- "$selection" "$HISTFILE" > "$TMP_HISTFILE" || true
echo "$selection" >> "$TMP_HISTFILE"
mv -f "$TMP_HISTFILE" "$HISTFILE"

# A name for the tmux session
session_name="$(echo "$selection" | tr '.-' _)"

# Create the session if it doesn't exist
if ! tmux has-session -t "$session_name" 2>/dev/null; then
    tmux new-session -ds "$session_name" ssh "$selection"
fi

if [[ ! -z ${TMUX:-} ]]; then
    # If we are already in a tmux session, attach to the new session on window with id 0
    tmux switch-client -t "$session_name"
else
    # If we are not in a tmux session, attach to the new session
    tmux attach-session -t "$session_name"
fi
