#!/usr/bin/env bash
# # TMUX Sessionizer
# A utility written for bash using FZF to quickly create new TMUX sessions
# for git repositories in my sessionizer path.
#
# ## Installation
# Example tmux usage:
# ```
# bind C-s display-popup -E "tmux-sessionizer"
# ```
# Add the above line to your `~/.tmux.conf` to open tmux-sessionizer in a popup
# by pressing `ctrl` and `s`.
#
# ## Customization
# To customize, you should set the `TMUX_SESSIONIZER_PATHS` variable.
# It can be a `:` separated list of directories in which the sessionizer will
# search for GIT repositories. Only a depth of `1` is searched.
#
# Example: `TMUX_SESSIONIZER_PATHS=/tmp:/some/other/path`
#
# ## History
# Selections are recorded at `~/.local/state/tmux-sessionizer/history` and used
# to order the available entries, most-recently-used first.
# Pick "✎ edit history" to edit the file in $EDITOR.

histfile="${TMUX_SESSIONIZER_HISTFILE:-${XDG_STATE_HOME:-$HOME/.local/state}/tmux-sessionizer/history}"

edit_history_entry='✎ edit history'

# Generates the list of available options, but uses the histfile as a hint for how to order them
order_by_history() {
    awk -F'\t' -v hf="$histfile" '
        BEGIN {
            while ((getline line < hf) > 0) {
                if (line != "" && !(line in rank)) rank[line] = ++n
            }
        }
        {
            key = ($NF in rank) ? rank[$NF] : 1000000 + NR
            printf "%d\t%s\n", key, $0
        }
    ' | sort -n -k1,1 | cut -f2-
}

# Record a selection at the top of the history file, removing duplicates in the process
record_history() {
    mkdir -p "$(dirname "$histfile")"
    local tmp; tmp=$(mktemp "${TMPDIR:-/tmp}/tmux-sessionizer.XXXXXX")
    { printf '%s\n' "$1"; [[ -f "$histfile" ]] && grep -Fxv -- "$1" "$histfile"; } > "$tmp"
    mv -f "$tmp" "$histfile"
}

# Open the history file in $EDITOR.
edit_history() {
    mkdir -p "$(dirname "$histfile")"
    touch "$histfile"
    local -a editor
    read -r -a editor <<< "${EDITOR:-vi}"
    "${editor[@]}" "$histfile"
}

if [[ $# -eq 1 ]]; then
    selected=$1
else
    IFS=':' read -ra search_dirs <<< "${TMUX_SESSIONIZER_PATHS:-$HOME/projects}"
    existing_dirs=()
    for dir in "${search_dirs[@]}"; do
        [[ -d "$dir" ]] && existing_dirs+=("$dir")
    done
    if [[ ${#existing_dirs[@]} -gt 0 ]]; then
        # Build "label<TAB>path" entries. The label (and thus the session name)
        # is prefixed with the search-dir it lives under ("root/repo") so that
        # repos with the same basename under different search dirs don't collide.
        # A bare repo expands to the bare repo itself plus each of its worktrees,
        # labelled "root/repo#worktree".
        entries=()
        while IFS= read -r dir; do
            label="$(basename "$(dirname "$dir")")/$(basename "$dir")"
            # A bare repo keeps its git files (HEAD, objects, refs) at the top
            # level; a normal project keeps them under .git. This cheap test
            # avoids spawning git for every (mostly non-bare) directory.
            if [[ -f "$dir/HEAD" && -d "$dir/objects" && -d "$dir/refs" ]]; then
                entries+=("$label"$'\t'"$dir")
                while IFS= read -r worktree; do
                    [[ "$worktree" == "$dir" ]] && continue
                    entries+=("$label#$(basename "$worktree")"$'\t'"$worktree")
                done < <(git -C "$dir" worktree list --porcelain \
                    | awk '/^worktree /{print $2}')
            else
                entries+=("$label"$'\t'"$dir")
            fi
        done < <(find "${existing_dirs[@]}" -mindepth 1 -maxdepth 1 -type d)
        # Alphabetical for determinism, then pull most-recently-used to the top.
        while true; do
            selection=$( {
                printf '%s\n' "${entries[@]}" | sort -t$'\t' -k1,1 | order_by_history
                printf '%s\n' "$edit_history_entry"
            } | fzf --delimiter='\t' --with-nth=1)
            [[ "$selection" == "$edit_history_entry" ]] || break
            edit_history
        done
        if [[ -n $selection ]]; then
            selected=${selection#*$'\t'}
            session_name=$(printf '%s' "${selection%%$'\t'*}" | tr . _)
            record_history "$selected"
        fi
    fi
fi

if [[ -z $selected ]]; then
    exit 0
fi

session_name=${session_name:-$(basename "$selected" | tr . _)}

# Create the session if it doesn't exist
if ! tmux has-session -t "=$session_name" 2>/dev/null; then
    tmux new-session -ds "$session_name" -c "$selected"
fi

if [[ ! -z ${TMUX:-} ]]; then
    # If we are already in a tmux session, attach to the new session on window with id 0
    tmux switch-client -t "=$session_name"
else
    # If we are not in a tmux session, attach to the new session
    tmux attach-session -t "=$session_name"
fi
