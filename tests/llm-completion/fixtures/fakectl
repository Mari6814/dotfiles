#!/bin/bash
set -u

STATE_DIR=${FAKECTL_STATE_DIR:-${TMPDIR:-/tmp}/llm-completion-test}
IMAGES=$STATE_DIR/images.tsv
CONTAINERS=$STATE_DIR/containers.tsv

write_default_images() {
    printf 'nginx:latest\timg-nginx\t25MB\n'
    printf 'alpine:latest\timg-alpine\t5MB\n'
}

write_default_containers() {
    printf 'web\tnginx:latest\trunning\t8080:80\n'
    printf 'db\talpine:latest\tstopped\t\n'
}

ensure_state() {
    mkdir -p "$STATE_DIR"
    [[ -f $IMAGES ]] || write_default_images >"$IMAGES"
    [[ -f $CONTAINERS ]] || write_default_containers >"$CONTAINERS"
}

reset_state() {
    mkdir -p "$STATE_DIR"
    write_default_images >"$IMAGES"
    write_default_containers >"$CONTAINERS"
}

die() {
    printf 'fakectl: %s\n' "$*" >&2
    exit 1
}

image_exists() {
    awk -F '\t' -v img="$1" '$1 == img { found = 1 } END { exit !found }' "$IMAGES"
}

image_field() {
    awk -F '\t' -v img="$1" -v col="$2" '$1 == img { print $col; exit }' "$IMAGES"
}

container_exists() {
    awk -F '\t' -v n="$1" '$1 == n { found = 1 } END { exit !found }' "$CONTAINERS"
}

container_field() {
    awk -F '\t' -v n="$1" -v col="$2" '$1 == n { print $col; exit }' "$CONTAINERS"
}

set_container_state() {
    local name=$1 state=$2 tmp
    tmp=$(mktemp)
    awk -F '\t' -v OFS='\t' -v n="$name" -v s="$state" '
        $1 == n { $3 = s }
        { print }
    ' "$CONTAINERS" >"$tmp"
    mv "$tmp" "$CONTAINERS"
}

remove_container() {
    local name=$1 tmp
    tmp=$(mktemp)
    awk -F '\t' -v OFS='\t' -v n="$name" '$1 != n { print }' "$CONTAINERS" >"$tmp"
    mv "$tmp" "$CONTAINERS"
}

help_root() {
    cat <<'EOF'
fakectl - fake container CLI

Usage:
  fakectl [OPTIONS] COMMAND
  fakectl COMMAND --help

Commands:
  container   Manage containers
  image       Manage images
  reset       Reset the fake state

Options:
      --verbose   Verbose output
  -h, --help      Show help
EOF
}

help_container() {
    cat <<'EOF'
Usage: fakectl container COMMAND

Manage containers

Commands:
  run         Create and run a container from an image
  ps          List containers
  stop        Stop one or more running containers
  start       Start one or more stopped containers
  rm          Remove one or more containers
  inspect     Inspect a container

Options:
  -h, --help  Show help
EOF
}

